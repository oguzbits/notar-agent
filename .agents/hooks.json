{
  "command-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/guard-command.js",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "file-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/guard-file.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
