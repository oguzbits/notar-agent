# ==============================================================================
# Notar Agent – Umgebungsvariablen-Vorlage (.env.example)
# Kopiere diesen Inhalt nach .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KI-Provider Konfiguration (Mindestens ein API-Key erforderlich)
# ------------------------------------------------------------------------------
# Anthropic Claude (Standard für produktives Parsing & Red-Teaming)
ANTHROPIC_API_KEY="sk-ant-..."

# Alternativ: Google Gemini
# GEMINI_API_KEY="AIzaSy..."
# GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy..."

# Modell-Auswahl (z. B. 'claude-haiku-4-5', 'claude-sonnet-4-5', 'gemini-2.5-flash')
AI_MODEL="claude-haiku-4-5"

# Optionaler expliziter Provider ('anthropic' | 'google')
# AI_PROVIDER="anthropic"

# Offline-/Mock-Modus für lokale UI-Entwicklung ohne API-Verbrauch
MOCK_AI="false"

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL 17 (SSOT, RLS & Jobs)
# ------------------------------------------------------------------------------
# Lokale Docker-Instanz via 'npm run db:start'
NEXT_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional: Webhook Secret für externe Supabase DB-Trigger
# SUPABASE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 3. Model Evaluation & Benchmark (Promptfoo)
# ------------------------------------------------------------------------------
# Optionale dedizierte Keys für Benchmark-Läufe (npm run eval:smoke / eval:live)
# EVAL_ANTHROPIC_API_KEY="sk-ant-..."
# EVAL_ANTHROPIC_AI_MODEL="claude-4-5-haiku"
# EVAL_GEMINI_API_KEY="AIzaSy..."
# EVAL_GEMINI_AI_MODEL="gemini-3.5-flash"
