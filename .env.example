# ==============================================================================
# Notar Agent – Umgebungsvariablen-Vorlage (.env.example)
# Kopiere diesen Inhalt nach .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KI-Provider Konfiguration (Mindestens ein API-Key erforderlich)
# ------------------------------------------------------------------------------
# Anthropic Claude (Standard für produktives Parsing & Red-Teaming)
ANTHROPIC_API_KEY="sk-ant-..."

# Alternativ: Google Gemini
# GEMINI_API_KEY="AIzaSy..."

# Modell-Auswahl (z. B. 'claude-haiku-5-5', 'claude-sonnet-4-5', 'gemini-2.5-flash')
AI_MODEL="claude-haiku-5-5"

# Optionaler expliziter Provider ('anthropic' | 'google')
# AI_PROVIDER="anthropic"

# Hochpräzises PDF- & Urkunden-Parsing (Standard: gemini-3.5-flash-lite, Fallback: gemini-3.1-flash-lite, nur bis zu dessen Abschaltung am 07.05.2027)
GEMINI_PARSE_MODEL="gemini-3.5-flash-lite"
GEMINI_PARSE_FALLBACK_MODEL="gemini-3.1-flash-lite"

# Vektorsuche (optional): Einbettungsmodell. Ohne Wert sucht die Pipeline nur im Volltext.
# Nutzt GEMINI_API_KEY. Im Free Tier darf der Anbieter Eingaben zur Produktverbesserung nutzen:
# nur mit synthetischen Daten verwenden.
# EMBEDDING_MODEL_ID="gemini-embedding-2"

# Offline-/Mock-Modus für lokale UI-Entwicklung ohne API-Verbrauch
MOCK_AI="false"

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL 17 (SSOT, RLS & Jobs)
# ------------------------------------------------------------------------------
# Lokale Docker-Instanz via 'npm run db:start'
NEXT_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Hintergrundläufe (Löschpipeline): Service-Role-Key nur serverseitig, Cron-Secret für /api/cron/deletion
SUPABASE_SERVICE_ROLE_KEY=""
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 3. Model Evaluation & Benchmark (Promptfoo)
# ------------------------------------------------------------------------------
# Optionale dedizierte Keys für Benchmark-Läufe (npm run eval:smoke / eval:live)
# EVAL_ANTHROPIC_API_KEY="sk-ant-..."
# EVAL_ANTHROPIC_AI_MODEL="claude-4-5-haiku"
# EVAL_GEMINI_API_KEY="AIzaSy..."
# EVAL_GEMINI_AI_MODEL="gemini-3.6-flash"

# ------------------------------------------------------------------------------
# Fehler-Tracking (Sentry, nur EU-Region; leer lassen = aus)
# ------------------------------------------------------------------------------
# DSN muss auf *.ingest.de.sentry.io zeigen. Server und Browser lesen je eine Variable.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
