# ==============================================================================
# NotarPartner - Umgebungsvariablen (.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Anthropic API Konfiguration (Claude Haiku 4.5 / Sonnet 5)
# ------------------------------------------------------------------------------
# Erforderlich: API-Key von Anthropic (z. B. sk-ant-api03-...)
ANTHROPIC_API_KEY=

# Optional: Modell-Wahl (Standard: claude-haiku-4-5 für schnelles & kosteneffizientes Parsing; alternativ claude-sonnet-5)
AI_MODEL="claude-haiku-4-5"

# ------------------------------------------------------------------------------
# 2. Persistenz / Datenbank (Supabase)
# ------------------------------------------------------------------------------
# Optional: Supabase Credentials für persistente Speicherung der Dossiers
# Empfehlung für einfaches Testen: Einfach leer lassen! 
# Die App läuft dann vollständig im In-Memory-Modus (Daten im Server-RAM bis zum Server-Neustart).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
