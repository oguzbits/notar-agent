{
  "name": "notar-partner-prototyp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint",
    "depcruise": "depcruise --config config/dependency-cruiser.js src",
    "knip": "knip",
    "knip:files": "knip --dependencies --files",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.69",
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-query": "^5.102.8",
    "ai": "^7.0.92",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.10.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.35.1",
    "lint-staged": "^17.4.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0",
    "zod-validation-error": "^5.0.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "knip": {
    "entry": [
      "src/app/**/*.{ts,tsx}",
      "src/lib/dossier/index.ts"
    ],
    "project": [
      "src/**/*.{ts,tsx}"
    ],
    "ignore": [
      "src/components/ui/index.ts"
    ],
    "ignoreDependencies": [
      "eslint-plugin-import",
      "tailwindcss"
    ]
  }
}
