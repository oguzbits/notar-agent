{
  "name": "notar-partner-prototyp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "worker": "node --experimental-strip-types scripts/run-worker.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "audit:magic-strings": "node scripts/audit-magic-strings.mjs",
    "audit:duplication": "jscpd src --ignore \"**/*.test.*,**/*.spec.*\" --threshold 2 --reporters console",
    "check": "npm run type-check && npm run lint && npm run depcruise && npm run knip && npm run audit:magic-strings && npm run audit:duplication",
    "depcruise": "depcruise --config config/dependency-cruiser.js src",
    "depcruise:graph": "depcruise --config config/dependency-cruiser.js --output-type mermaid src > architecture.mmd",
    "depcruise:report": "depcruise --config config/dependency-cruiser.js --output-type err-html --output-to depcruise-report.html src",
    "knip": "knip --include dependencies,unlisted,binaries,unresolved,files,cycles",
    "knip:exports": "knip --exports",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --last-failed-file=/dev/null; rm -rf test-results",
    "test:e2e:headed": "playwright test --headed --last-failed-file=/dev/null; rm -rf test-results",
    "test:e2e:ui": "playwright test --ui --last-failed-file=/dev/null; rm -rf test-results",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.69",
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-query": "^5.102.8",
    "ai": "^7.0.92",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "eventsource-parser": "^4.1.0",
    "fast-json-stable-stringify": "^2.1.0",
    "file-saver": "^2.0.5",
    "file-type": "^22.1.0",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "p-limit": "^7.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.10.0",
    "husky": "^9.1.7",
    "jscpd": "^5.2.0",
    "jsdom": "^29.1.1",
    "knip": "^6.35.1",
    "lint-staged": "^17.4.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0",
    "zod-validation-error": "^5.0.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "knip": {
    "entry": [
      "src/app/**/*.{ts,tsx}",
      "src/lib/dossier/index.ts"
    ],
    "project": [
      "src/**/*.{ts,tsx}"
    ],
    "ignore": [
      "src/components/ui/index.ts"
    ],
    "ignoreDependencies": [
      "eslint-plugin-import",
      "tailwindcss"
    ]
  }
}
